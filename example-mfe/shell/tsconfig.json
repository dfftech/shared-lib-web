{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "lib": [
      "ES2024",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "vite/client",
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "shared-lib-web": [
        "../../src/index.ts"
      ],
      "shared-lib-web/layout": [
        "../../src/layout.ts"
      ],
      "*": [
        "./node_modules/@types/*",
        "./node_modules/*"
      ]
    }
  },
  "include": [
    "src",
    "../shared/config.ts",
    "../shared/roles.ts",
    "../shared/layout-choice.ts",
    "vite.config.ts"
  ]
}
